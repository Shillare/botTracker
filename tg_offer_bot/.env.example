# === Telegram ===============================================================
# Токен от @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Прокси для связи с Telegram, например http://127.0.0.1:10809 (xray/Neocor).
# Нужен, когда api.telegram.org недоступен напрямую: VPN в режиме «системного
# прокси», DPI или блокировка. aiogram системный прокси Windows НЕ читает, поэтому
# без этой строки бот падает с RECORD_LAYER_FAILURE, хотя в браузере всё работает.
# Оставьте пустым, если Telegram доступен напрямую.
TELEGRAM_PROXY=

# === Права доступа =========================================================
# Владелец(ы) бота: только они выдают и снимают права администратора
# командами /add_admin и /remove_admin. Владелец всегда админ.
OWNER_IDS=111111111
# Дополнительные админы через запятую. Засеиваются в БД один раз при первом
# запуске, дальше меняются только командами владельца.
ADMIN_IDS=

# === Хранилище =============================================================
DB_PATH=data/bot.sqlite3

# === Бизнес-аккаунт ========================================================
# Обычно не требуется: business_connection_id берётся из входящих апдейтов.
# Заполняйте, только если нужно всегда писать от имени конкретного аккаунта.
DEFAULT_BUSINESS_CONNECTION_ID=

# === Предложения ===========================================================
# Срок действия карточки: 359 минут = 5ч 59м.
OFFER_TTL_MINUTES=359

# Кто может нажать «Принять»/«Отклонить»:
#   anyone         — любой участник чата (в личном чате — только собеседник)
#   author          — только автор команды benz
#   business_owner  — только владелец бизнес-аккаунта
ACCEPT_POLICY=anyone

# Язык карточки, если в команде не указан суффикс: ru / en / ar.
# Суффикс в конце команды важнее: «benz <ссылка> <цена> <валюта> EU» -> английский,
# «... ar» -> арабский. Переводятся текст карточек, кнопки и все ответы бота.
DEFAULT_LANGUAGE=ru

# Обрабатывать benz только от владельца бота. В группах команду
# может набрать любой участник, а отвечать бот будет от имени аккаунта.
ONLY_BUSINESS_OWNER_COMMANDS=true

# Удалять сообщение с командой benz. Удаление идёт ДО отправки карточки,
# поэтому сырой текст «benz ...» в чате не мелькает.
DELETE_COMMAND_MESSAGE=true

# Пейсинг для benz: минимальный интервал между командами одного человека.
# Команды не выбрасываются — лишние ждут своей очереди и обрабатываются.
# Работает и как защита от спама, и как защита от флуд-лимита Telegram.
OFFER_THROTTLE_SECONDS=0.5

# Подпись валюты Stars. Значение по умолчанию — «Ѕtarѕ»: Telegram режет
# (PEER_FLOOD) сообщения со словом «Stars» рядом с внешней ссылкой, если
# получатель не писал боту. Поставьте Stars, если бот работает только
# через бизнес-подключение (там фильтр не действует).
STARS_LABEL=Ѕtarѕ

# Переопределение подписей остальных валют: «Gram=Gram,TON=TON».
CURRENCY_LABELS=

# Deep link кнопки «Передать». Плейсхолдер {username} — получатель подарка.
TRANSFER_DEEP_LINK=tg://send_gift?to={username}

# Username получателя по умолчанию (без @), если он не указан в команде
# и у нажавшего «Принять» нет публичного username.
TRANSFER_RECIPIENT_USERNAME=

# Кнопка «Как передать» в карточке «продан». Пусто — кнопка не показывается.
HOW_TO_TRANSFER_URL=

# === Логи ==================================================================
LOG_LEVEL=INFO
LOG_FILE=data/logs/bot.log
LOG_ROTATION_BYTES=5242880
LOG_ROTATION_BACKUPS=3
